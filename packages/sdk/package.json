{
  "name": "@resolvetrace/sdk",
  "version": "0.1.0",
  "description": "ResolveTrace TypeScript SDK — create events, checkpoints, verify bundles, and interact with Stellar",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@resolvetrace/protocol": "*",
    "@resolvetrace/storage": "*",
    "stellar-sdk": "13.3.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.13",
    "@types/node": "22.0.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.5.4"
  }
}
