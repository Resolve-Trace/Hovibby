# ============================================================
# ResolveTrace Environment Configuration
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.
# ============================================================

# ---- Stellar / Soroban ----
# Network: "testnet" | "mainnet" | "standalone"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Stellar RPC endpoint (Testnet default)
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Horizon endpoint (for account funding on testnet)
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Deployed contract address (set after running: stellar contract deploy ...)
NEXT_PUBLIC_CONTRACT_ID=

# Network passphrase (do not change unless using a custom network)
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ---- Storage ----
# Adapter: "filesystem" | "s3"
STORAGE_ADAPTER=filesystem

# Path for local filesystem storage (relative to project root)
STORAGE_FS_PATH=./resolvetrace-data

# S3-compatible storage (only required when STORAGE_ADAPTER=s3)
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# ---- Security ----
# API authentication token — ALL /api/* routes require this.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Optional in development (routes are open if unset, with a warning).
SERVER_API_KEY=

# Client-side copy of the API key — must match SERVER_API_KEY exactly.
# NEXT_PUBLIC_* variables are embedded in the browser bundle, so keep this key
# to a reasonable length and rotate it if it leaks.
# Required in production. Optional in development.
NEXT_PUBLIC_API_KEY=

# Server-side Ed25519 signing key for event signatures.
# Events signed with this key are permanently verifiable by anyone with the public key.
# Generate: node scripts/generate-signing-key.mjs
# Required in production. Optional in development (ephemeral key used if unset, with a warning).
SERVER_SIGNING_KEY_HEX=

# ---- Application ----
# Enable demo mode (true | false)
NEXT_PUBLIC_DEMO_MODE=false

# Application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protocol version
NEXT_PUBLIC_PROTOCOL_VERSION=1
